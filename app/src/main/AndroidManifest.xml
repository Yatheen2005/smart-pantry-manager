<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="za.ac.richfield.smartpantry">

    <!-- Note: No location, GPS, or mapping permissions are requested per assignment brief -->

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_pantry_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_pantry_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartPantryManager">

        <!-- Screen 1: Pantry List Screen (Main Launcher Activity) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Add / Edit Pantry Ingredient Screen -->
        <activity
            android:name=".ui.AddEditIngredientActivity"
            android:exported="false"
            android:label="@string/title_add_ingredient"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Screen 3: Suggested Recipes Screen (Strict Matching Engine) -->
        <activity
            android:name=".ui.SuggestedRecipesActivity"
            android:exported="false"
            android:label="@string/title_suggested_recipes"
            android:parentActivityName=".ui.MainActivity" />

        <!-- Screen 4: Recipe Detail Screen -->
        <activity
            android:name=".ui.RecipeDetailActivity"
            android:exported="false"
            android:label="@string/title_recipe_detail"
            android:parentActivityName=".ui.SuggestedRecipesActivity" />

        <!-- Screen 5: Settings & Preferences Screen -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".ui.MainActivity" />

    </application>

</manifest>
